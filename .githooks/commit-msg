#!/usr/bin/env bash
# Strips attribution trailers before a commit is finalized: the human maintainer is the sole
# author and contributor, so no coding agent or vendor appears in the contributor graph (see
# AGENTS.md). Enable locally with:
#   git config core.hooksPath .githooks
set -euo pipefail

message_file="$1"
trailer_pattern='^(Co-Authored-By|Signed-off-by|Helped-by):'

if grep -qiE "$trailer_pattern" "$message_file"; then
  grep -viE "$trailer_pattern" "$message_file" > "$message_file.tmp"
  mv "$message_file.tmp" "$message_file"
  echo "commit-msg hook: removed attribution trailer(s); the maintainer is the sole author (see AGENTS.md)" >&2
fi
