{
  "name": "sdd-agentic-flow",
  "version": "1.9.0",
  "description": "A local-first, zero-dependency Spec Driven Development skill toolkit with capability-contracted skills, condensed TLC/TDD baselines, and adaptive feature sizing for coding agents.",
  "type": "commonjs",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gmartins-dev/sdd-agentic-flow.git"
  },
  "bugs": "https://github.com/gmartins-dev/sdd-agentic-flow/issues",
  "homepage": "https://github.com/gmartins-dev/sdd-agentic-flow#readme",
  "files": [
    "bin",
    "skills",
    "shared",
    "presets",
    "examples",
    "docs",
    "scripts",
    "README.md",
    "README.pt-BR.md",
    "LICENSE",
    "NOTICE",
    "LICENSING.md",
    "LICENSES",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "CHANGELOG.md",
    "ROADMAP.md"
  ],
  "scripts": {
    "build": "node --check ./bin/sdd-agentic-flow.js && node --check ./bin/contract-graph.js && node --check ./bin/version-compat.js",
    "lint": "node --check ./bin/sdd-agentic-flow.js && node --check ./bin/contract-graph.js && node --check ./bin/version-compat.js && node --check ./test/cli.test.js && node --check ./test/version-compat.test.js",
    "test": "node --test --experimental-test-coverage",
    "check": "npm run lint:check && npm run lint:yaml:check && npm run docs:check && bash ./scripts/check-skills.sh && npm run build && npm run lint && npm test",
    "lint:check": "biome check .",
    "lint:fix": "biome check . --write",
    "lint:yaml:check": "prettier --check \".github/workflows/**/*.{yml,yaml}\"",
    "lint:yaml:fix": "prettier --write \".github/workflows/**/*.{yml,yaml}\"",
    "docs:lint": "markdownlint \"**/*.md\" --ignore \"**/node_modules/**\" --ignore \"**/.specs/**\" --ignore \"**/.sdd/**\"",
    "docs:diagrams": "node scripts/check-mermaid.js",
    "docs:check": "npm run docs:lint && git ls-files \"*.md\" \":!.specs/**\" | xargs markdown-link-check -c .markdown-link-check.json && npm run docs:diagrams",
    "docs:fix": "git ls-files \"*.md\" \":!.specs/**\" | xargs prettier --write && markdownlint \"**/*.md\" --ignore \"**/node_modules/**\" --ignore \"**/.specs/**\" --ignore \"**/.sdd/**\" --fix",
    "lint:fix:all": "npm run lint:fix && npm run lint:yaml:fix && npm run docs:fix",
    "sanitize": "bash ./scripts/sanitize-private-context.sh",
    "pack:dry": "node scripts/pack-dry.js",
    "cli:dev": "node scripts/cli-dev.js",
    "cli:sandbox": "node scripts/cli-sandbox.js",
    "release:check": "bash scripts/release-checklist.sh"
  },
  "keywords": [
    "sdd",
    "spec-driven-development",
    "agentic-workflow",
    "ai-agents",
    "coding-agents",
    "ai-development",
    "software-engineering",
    "tdd",
    "skills",
    "tlc"
  ],
  "license": "MIT",
  "bin": {
    "sdd-agentic-flow": "bin/sdd-agentic-flow.js"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@mermaid-js/mermaid-cli": "^11.16.0",
    "markdown-link-check": "^3.15.0",
    "markdownlint-cli": "^0.49.1",
    "prettier": "^3.9.6"
  }
}
